# =============================================================================
# Mira-Evo — Modelo de variáveis de ambiente (.env)
# Instalação LOCAL (localhost) com MICROSOFT SQL SERVER e SEM Docker.
# Copie este arquivo para ".env" e preencha os valores.
# =============================================================================

# -----------------------------------------------------------------------------
# 1) BANCO DE DADOS — MICROSOFT SQL SERVER  (OBRIGATÓRIO)
# -----------------------------------------------------------------------------
# Formato:
#   sqlserver://HOST:1433;database=NOME;user=USUARIO;password=SENHA;encrypt=true;trustServerCertificate=true
#
# Exemplos (rodando o SQL Server na PRÓPRIA máquina):
#   Instância padrão:
#     sqlserver://localhost:1433;database=miraevo;user=miraevo;password=TROQUE_POR_UMA_SENHA_FORTE_E_UNICA;encrypt=true;trustServerCertificate=true
#   Instância nomeada (ex.: SQL Server Express):
#     sqlserver://localhost;instanceName=SQLEXPRESS;database=miraevo;user=miraevo;password=TROQUE_POR_UMA_SENHA_FORTE_E_UNICA;encrypt=true;trustServerCertificate=true
#   Autenticação integrada do Windows:
#     sqlserver://localhost:1433;database=miraevo;integratedSecurity=true;trustServerCertificate=true
#
# Observações:
#   - O banco (database) precisa existir antes da instalação. Crie com:
#       CREATE DATABASE miraevo;
#   - O usuário informado precisa de permissão db_owner nesse banco
#     (as tabelas são criadas automaticamente pelo instalador).
#   - Se a senha tiver caracteres especiais, use {chaves}: password={S3nh@;Forte}
DATABASE_URL=

# -----------------------------------------------------------------------------
# 2) AUTENTICAÇÃO  (OBRIGATÓRIO)
# -----------------------------------------------------------------------------
# Chave secreta que assina as sessões. Gere uma chave forte:
#   Windows     : powershell -c "[Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))"
#   Linux/macOS : openssl rand -base64 32
NEXTAUTH_SECRET=

# URL local de acesso ao sistema. Para uso na PRÓPRIA máquina, use localhost:
NEXTAUTH_URL=http://localhost:3000

# Porta do servidor (opcional, padrão 3000)
# PORT=3000

# -----------------------------------------------------------------------------
# 3) SENHA INICIAL DOS USUÁRIOS ADMINISTRATIVOS (opcional)
# -----------------------------------------------------------------------------
# Usada APENAS quando o banco está vazio e o seed cria os usuários padrão.
# Se não preencher, o instalador gera uma senha forte aleatória e a exibe UMA vez.
# A troca da senha é obrigatória no primeiro login.
# OBS.: no repositório público, dados_iniciais contém apenas fixtures vazias;
#       este seed só age se o banco estiver totalmente vazio.
# SEED_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# 4) ASSISTENTE — MODO RAG  (RECOMENDADO PARA USO INTERNO)
# -----------------------------------------------------------------------------
# ASSISTENTE_MODO=rag  -> o assistente responde EXCLUSIVAMENTE com base nos
#                         documentos da Base de Conhecimento interna.
#                         Nenhum dado sai da máquina. Não exige internet.
ASSISTENTE_MODO=rag

# -----------------------------------------------------------------------------
# 5) ESCALONAMENTO AUTOMÁTICO DE SLA  (OBRIGATÓRIO PARA O AGENDADOR)
# -----------------------------------------------------------------------------
# Chave que protege o endpoint de escalonamento de SLA (/api/services/escalate).
# O agendador (escalonar.bat/.sh) usa esta chave. Gere uma chave forte:
#   Windows     : powershell -c "[Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))"
#   Linux/macOS : openssl rand -base64 32
CRON_SECRET=


# -----------------------------------------------------------------------------
# 6) MIRA LOCAL FABRIC — PASTA DE REDE / ETL
# -----------------------------------------------------------------------------
# Troque APENAS o caminho abaixo quando souber o compartilhamento real.
# Pode ser UNC (recomendado): \\SERVIDOR\PASTA_ETL\MIRA-EVO\releases
# ou unidade mapeada:        Z:\MIRA-EVO\releases
#
# O MIRA roda LOCALMENTE; essa pasta serve somente para DISTRIBUIR atualizacoes.
MIRA_UPDATE_PATH=\\SERVIDOR\PASTA_ETL\MIRA-EVO\releases

# Ao iniciar o MIRA, verifica o manifesto da pasta acima e so instala uma versao
# nova quando o SHA-256 confere. Use false se quiser atualizar apenas manualmente.
MIRA_AUTO_UPDATE=true

# Caminhos reservados para a futura integracao por arquivos com a ferramenta ETL.
# Eles NAO substituem o banco nesta versao; apenas deixam o contrato preparado.
MIRA_ETL_PATH=\\SERVIDOR\PASTA_ETL\MIRA-EVO\etl
MIRA_KNOWLEDGE_PATH=\\SERVIDOR\PASTA_ETL\MIRA-EVO\knowledge

# Ollama local. Depois de instalar, a API normalmente fica nesta URL.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# =============================================================================
# RECURSOS OPCIONAIS — o sistema funciona normalmente sem eles
# =============================================================================

# IA externa (2FA por e-mail, importação por e-mail, resumo automático).
# Deixe vazio numa instalação fechada — o Assistente RAG cobre a consulta interna.
# ABACUSAI_API_KEY=

# Armazenamento de imagens do Fórum em nuvem (S3). Sem isso, o upload de
# imagens no fórum fica indisponível; o restante do fórum funciona.
# AWS_REGION=us-east-1
# AWS_BUCKET_NAME=
# AWS_FOLDER_PREFIX=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Destinatário do relatório diário (obrigatório apenas se o job de relatório for usado)
# DAILY_REPORT_EMAIL=relatorios@empresa.com
